rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function isCreatingWithOwner() {
      return isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /projects/{projectId} {
      allow read, update, delete: if isOwner();
      allow create: if isCreatingWithOwner();
    }

    match /tasks/{taskId} {
      allow read, update, delete: if isOwner();
      allow create: if isCreatingWithOwner();
    }

    match /activeTimers/{timerId} {
      allow read, update, delete: if isOwner();
      allow create: if isCreatingWithOwner();
    }

    match /records/{recordId} {
      allow read, update, delete: if isOwner();
      allow create: if isCreatingWithOwner();
    }
  }
}
